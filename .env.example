# ---- Application Configuration ----
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=*

# ---- Database Configuration ----
# SQLite for local development (default)
DATABASE_URL=sqlite:///./shopsathi.db
# Upgrade to PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@host:5432/shopsathi

# ---- API Security ----
# Set a secret value to enable X-API-Key header verification on protected endpoints.
# Leave empty or unset to bypass during local development.
SHOP_SATHI_API_KEY=

# ---- AI Integration (Optional Future Upgrade) ----
# The Chat and Voice agents currently work without any external AI API key.
# To upgrade the Chat Agent to use the Gemini API for natural language understanding,
# add your Gemini API key below (server-side only — never expose in frontend code).
GEMINI_API_KEY=your_gemini_api_key_here
